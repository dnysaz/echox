---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'echoX | Free online music' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="echoX: free music, radio and podcasts. Stream full tracks from Audius, 30-second previews from Deezer and iTunes, podcast episodes and live radio."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
