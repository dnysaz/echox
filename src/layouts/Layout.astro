---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'echoX | Free online music' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta
      name="description"
      content="echoX: free music, radio and podcasts. Stream full tracks from Audius, 30-second previews from Deezer and iTunes, podcast episodes and live radio."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#08080a" />
    <meta name="application-name" content="echoX" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="echoX" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <div class="install-banner" id="install-banner" role="dialog" aria-label="Install echoX" hidden>
      <img class="install-icon" src="/icon-192.png" alt="" width="44" height="44" />
      <div class="install-copy">
        <strong>Install echoX</strong>
        <span>Full screen, no browser bars, one tap away.</span>
      </div>
      <button class="install-go" id="install-go" type="button">Install</button>
      <button class="install-close" id="install-close" type="button" aria-label="Not now">×</button>
    </div>

    <script>
      import '../scripts/pwa';
    </script>
  </body>
</html>
