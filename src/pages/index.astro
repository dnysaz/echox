---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="app">
    <aside class="sidebar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">♪</span>
        <span class="brand-text">EchoX</span>
      </a>

      <nav class="nav" aria-label="Main navigation">
        <button type="button" class="nav-item active" data-view="home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 10.5 12 3l9 7.5" /><path d="M5.5 9.5V21h13V9.5" />
          </svg>
          <span class="nav-label">Home</span>
        </button>
        <button type="button" class="nav-item" data-view="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
          </svg>
          <span class="nav-label">Search</span>
        </button>
        <button type="button" class="nav-item" data-view="library">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 3.8C19 15.6 12 20 12 20Z" />
          </svg>
          <span class="nav-label">Liked</span>
        </button>
      </nav>

      <div class="sidebar-section">
        <h3>Audio sources</h3>
        <p>
          Full tracks come from <strong>Audius</strong>, previews from <strong>iTunes</strong>.
          No music files are hosted here.
        </p>
      </div>

      <footer class="sidebar-foot">
        Audio &amp; data: Audius, Apple iTunes.<br />
        <a href="/terms">Terms &amp; conditions</a>
      </footer>
    </aside>

    <main class="main">
      <header class="topbar">
        <label class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="Search songs, artists, genres…"
            autocomplete="off"
            aria-label="Search music"
          />
        </label>
        <span class="pill">beta</span>
      </header>

      <section class="detail" id="detail" hidden aria-live="polite">
        <button class="detail-close" id="detail-close" type="button" aria-label="Close">×</button>

        <div class="detail-head">
          <div class="detail-art" id="detail-art"><span aria-hidden="true">♪</span></div>
          <div class="detail-copy">
            <p class="detail-eyebrow">Now playing</p>
            <h2 id="detail-title">—</h2>
            <p class="detail-artist" id="detail-artist">—</p>
            <div class="detail-foot">
              <span class="detail-meta" id="detail-meta"></span>
              <div class="detail-actions">
                <button class="detail-play" id="detail-play" type="button" aria-label="Play"></button>
                <button class="icon-btn" id="detail-like" type="button" aria-label="Like song">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 3.8C19 15.6 12 20 12 20Z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="detail-list-head">
          <h3>More from <span id="detail-artist-name">this artist</span></h3>
          <span id="detail-count"></span>
        </div>
        <div class="tracklist" id="detail-list"></div>
      </section>

      <section id="view-home" class="view">
        <div class="hero">
          <p class="eyebrow">Free · legal · no subscription</p>
          <h1>Free music,<br />no strings attached.</h1>
          <p class="sub">
            Stream full tracks from Audius and 30-second previews from iTunes.
            Every song plays straight from its official source.
          </p>
          <p class="hero-note">
            A free hobby project — no guarantees, just for fun.
            <a href="/terms">Read the terms</a>.
          </p>
          <div class="chips" id="genre-chips"></div>
        </div>

        <div class="section-head">
          <h2>Trending now</h2>
          <span>Audius</span>
        </div>
        <div id="trending-grid"></div>
      </section>

      <section id="view-search" class="view" hidden>
        <h2 id="search-heading">Search results</h2>
        <p class="search-hint" id="search-hint">
          Type at least 2 characters to search full tracks on Audius and previews on iTunes.
        </p>

        <div class="section-head">
          <h2>Full tracks · Audius</h2>
          <span>full streaming</span>
        </div>
        <div id="audius-results"></div>

        <div class="section-head">
          <h2>30-second previews · iTunes</h2>
          <span>Apple Music</span>
        </div>
        <div id="itunes-results"></div>
      </section>

      <section id="view-library" class="view" hidden>
        <h2>Your liked songs</h2>
        <div class="section-head">
          <h2>Saved on this device</h2>
          <span>localStorage</span>
        </div>
        <div id="liked-status">
          <div class="status">No liked songs yet. Tap the heart while a song is playing.</div>
        </div>
        <div id="liked-grid"></div>
      </section>
    </main>
  </div>

  <div class="player disabled" id="player">
    <div class="now">
      <div class="now-art" id="now-art"><span aria-hidden="true">♪</span></div>
      <div class="now-meta">
        <div class="now-title" id="now-title">Nothing playing</div>
        <div class="now-artist" id="now-artist">Pick a song to start</div>
        <div class="now-src" id="now-src"></div>
      </div>
      <button class="icon-btn" id="like-btn" type="button" aria-label="Like song" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 3.8C19 15.6 12 20 12 20Z" />
        </svg>
      </button>
    </div>

    <div class="player-center">
      <div class="controls">
        <button class="icon-btn" id="prev-btn" type="button" aria-label="Previous song">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 5h2v14H7zM19 5.5v13L9.5 12z" />
          </svg>
        </button>
        <button class="play-btn" id="play-btn" type="button" aria-label="Play"></button>
        <button class="icon-btn" id="next-btn" type="button" aria-label="Next song">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M15 5h2v14h-2zM5 5.5v13L14.5 12z" />
          </svg>
        </button>
      </div>
      <div class="progress-row">
        <span id="cur">0:00</span>
        <input id="seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Seek" />
        <span id="dur">0:00</span>
      </div>
    </div>

    <div class="player-right">
      <button class="icon-btn" id="mute-btn" type="button" aria-label="Mute">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9.5h3L12 5v14L7 14.5H4z" /><path d="M16 9a4 4 0 0 1 0 6" />
        </svg>
      </button>
      <input id="volume" type="range" min="0" max="1" step="0.01" value="0.8" aria-label="Volume" />
    </div>
  </div>

  <audio id="audio" preload="metadata"></audio>
</Layout>

<script>
  import { init } from '../scripts/app';
  init();
</script>
