---
const title = 'echoX player';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="echoX: free music, radio and podcasts. Stream full tracks from Audius, previews from Deezer and iTunes, podcast episodes and live radio." />
    <meta name="theme-color" content="#08080a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #08080a;
        --text: #f5f5f7;
        --muted: #9b9ba7;
        --line: #26262f;
        --accent: #ff7a00;
      }

      * { box-sizing: border-box; }
      [hidden] { display: none !important; }

      html, body { height: 100%; margin: 0; }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
      }

      button { font: inherit; color: inherit; }

      button:focus-visible,
      a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .embed {
        position: relative;
        height: 100dvh;
        min-height: 120px;
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
      }

      .backdrop,
      .scrim {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .backdrop {
        inset: -25%;
        background: center / cover no-repeat;
        filter: blur(46px) saturate(1.6) brightness(.85);
        opacity: .5;
      }
      .scrim {
        background: linear-gradient(100deg, rgba(8, 8, 10, .82), rgba(8, 8, 10, .92));
      }

      .inner { position: relative; display: grid; gap: 10px; min-width: 0; }

      .card { display: flex; align-items: center; gap: 12px; min-width: 0; }

      .art {
        position: relative;
        width: 60px;
        height: 60px;
        flex: none;
        display: grid;
        place-items: center;
        overflow: hidden;
        border-radius: 10px;
        background: #262630;
        color: #4b4b57;
        font-size: 22px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, .45);
      }
      .art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

      .copy { flex: 1; min-width: 0; }
      .kicker {
        margin: 0 0 4px;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--accent);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .title {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
        letter-spacing: -.2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .artist {
        margin: 3px 0 0;
        font-size: 12px;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .desc {
        margin: 3px 0 0;
        font-size: 11px;
        line-height: 1.4;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .play {
        width: 46px;
        height: 46px;
        flex: none;
        display: grid;
        place-items: center;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: var(--accent);
        color: #1c0d00;
        cursor: pointer;
        transition: transform .15s, filter .15s;
      }
      .play:hover { transform: scale(1.05); filter: brightness(1.07); }
      .play:active { transform: scale(.97); }
      .play:disabled { opacity: .5; cursor: default; transform: none; }
      .play svg { display: block; width: 20px; height: 20px; }

      .foot { display: flex; align-items: center; gap: 10px; min-width: 0; }

      .progress {
        position: relative;
        flex: 1;
        height: 4px;
        min-width: 40px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .14);
        cursor: pointer;
      }
      .fill {
        display: block;
        width: 0;
        height: 100%;
        border-radius: inherit;
        background: var(--accent);
        transition: width .12s linear;
      }

      .time {
        flex: none;
        font-size: 10.5px;
        font-variant-numeric: tabular-nums;
        color: var(--muted);
        white-space: nowrap;
      }

      .brand {
        flex: none;
        margin-left: auto;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .04em;
        color: var(--text);
        text-decoration: none;
      }
      .brand:hover { color: var(--accent); }

      .error {
        margin: 0;
        font-size: 11.5px;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <main class="embed">
      <div class="backdrop" id="backdrop" aria-hidden="true"></div>
      <div class="scrim" aria-hidden="true"></div>

      <div class="inner">
        <div class="card">
          <div class="art" id="art"><span aria-hidden="true">♪</span></div>
          <div class="copy">
            <p class="kicker" id="kicker">echoX</p>
            <p class="title" id="title">Loading…</p>
            <p class="artist" id="artist"></p>
            <p class="desc" id="desc"></p>
          </div>
          <button class="play" id="play" type="button" aria-label="Play" disabled>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </button>
        </div>

        <div class="foot">
          <div class="progress" id="progress" role="presentation" hidden><span class="fill" id="fill"></span></div>
          <span class="time" id="time"></span>
          <a class="brand" id="cta" href="/" target="_blank" rel="noreferrer">echoX ↗</a>
        </div>

        <p class="error" id="error" hidden></p>
      </div>

      <audio id="audio" preload="none"></audio>
    </main>

    <script>
      import '../scripts/embed';
    </script>
  </body>
</html>
